{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/perdomo/.config/opencode/AGENTS.md"],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:AGENTS_GITHUB_TOKEN}"
        }
      },
      "linkedin": {
        "type": "local",
        "command": ["uvx", "mcp-server-linkedin@latest"],
        "environment": {
          "UV_HTTP_TIMEOUT": "300"
        },
        "disabled": true
      }
    }
  }
}
