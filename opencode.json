{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/perdomo/.config/opencode/AGENTS.md"],
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },

    "linkedin": {
      "type": "local",
      "command": ["uvx", "mcp-server-linkedin@latest"],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      },
      "enabled": true
    }
  }
}
