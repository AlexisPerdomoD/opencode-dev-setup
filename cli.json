{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "low",
    "image_preview": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "indicators": "numbers"
  },
  "terminal": {
    "title": false,
    "copy": "select"
  }
}
